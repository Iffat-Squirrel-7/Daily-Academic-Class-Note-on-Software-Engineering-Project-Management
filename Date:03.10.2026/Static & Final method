class Student {
    // Static variables shared across all instances
    private static int studentCount = 0;
    private static final String UNIVERSITY_NAME = "MBSTU"; // Constant

    // Instance variables specific to each student
    private final int studentId; // Unique and immutable once assigned
    private String name;
    private String department;

    // Constructor
    public Student(String name, String department) {
        studentCount++;                 // Increment total student count
        this.studentId = studentCount;  // Auto-assign unique ID based on count
        this.name = name;
        this.department = department;
    }

    // Static method to access static variable
    public static int getTotalStudents() {
        return studentCount;
    }

    // Final method: cannot be overridden by any subclass
    public final void displayStudentInfo() {
        System.out.println("ID: " + studentId + 
                           " | Name: " + name + 
                           " | Dept: " + department + 
                           " | Varsity: " + UNIVERSITY_NAME);
    }

    // Getters
    public int getStudentId() {
        return studentId;
    }

    public String getName() {
        return name;
    }
}

public class Main {
    public static void main(String[] args) {
        // Creating student instances
        Student s1 = new Student("Rahim", "ICT");
        Student s2 = new Student("Karim", "CSE");
        Student s3 = new Student("Sumi", "TE");

        // Display individual student information using final method
        System.out.println("--- Student Details ---");
        s1.displayStudentInfo();
        s2.displayStudentInfo();
        s3.displayStudentInfo();

        // Accessing static method to get total count
        System.out.println("\n-----------------------");
        System.out.println("Total Registered Students: " + Student.getTotalStudents());
    }
}
